{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console", "ps-oson-service" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 600
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId"]
  },

  "OsonOptions": {
    "Token": "gQWgWTs9DhCtodYsINfB0GFmTihoK7n6qRuK4EXYJfy5WmpyPi",
    "Urls": {
      "Calculate": "/api/agent/payment/check/calculate",
      "Account": "/api/payment/check",
      "Pay": "/api/payment/pay",
      "Status": "/api/payment/check_status",
      "Service": "/api/agent/service/list",
      "Transaction": "api/agent/transaction/list",
      "Deposit": "/api/agent/deposit",
      "Base": "https://api.interhub.ae"
    }
  }
}